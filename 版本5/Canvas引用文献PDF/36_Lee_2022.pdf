    <rdf:Description dc:format="application/pdf" pdf:Keywords="expert; novice; primary scientific literature; reading strategies; science literacy" pdf:Producer="Adobe LiveCycle PDF Generator; modified using iTextÂ® 5.5.13.2 Â©2000-2020 iText Group NV (AGPL-version)" rdf:about="" xmlns:dc="http://purl.org/dc/elements/1.1/" xmlns:pdf="http://ns.adobe.com/pdf/1.3/" xmlns:terms="http://purl.org/dc/terms/" xmlns:xmp="http://ns.adobe.com/xap/1.0/" xmp:CreateDate="2020-11-17T00:11:24+05:30" xmp:MetadataDate="2022-12-06T07:22:35+05:30" xmp:ModifyDate="2022-12-06T07:22:35+05:30">
      <dc:title>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">From Novice To Expert: An Assessment To Measure Strategies Students Implement While Learning To Read Primary Scientific Literature</rdf:li>
        </rdf:Alt>
      </dc:title>
      <dc:identifier>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">10.1128/jmbe.00126-22</rdf:li>
        </rdf:Alt>
      </dc:identifier>
      <dc:creator>
        <rdf:Seq>
          <rdf:li>Sangah Lee</rdf:li>
          <rdf:li>Min Zhong</rdf:li>
          <rdf:li>Cerrone Foster</rdf:li>
          <rdf:li>Miriam Segura-Totten</rdf:li>
          <rdf:li>Melissa McCartney</rdf:li>
        </rdf:Seq>
      </dc:creator>
      <dc:description>
        <rdf:Alt>
          <rdf:li xml:lang="x-default">Research Article</rdf:li>
          <rdf:li xml:lang="x-repair">Research Article</rdf:li>
        </rdf:Alt>
      </dc:description>
      <dc:subject>
        <rdf:Bag>
          <rdf:li>expert</rdf:li>
          <rdf:li>novice</rdf:li>
          <rdf:li>primary scientific literature</rdf:li>
          <rdf:li>reading strategies</rdf:li>
          <rdf:li>science literacy</rdf:li>
        </rdf:Bag>
      </dc:subject>
      <dc:publisher>
        <rdf:Bag>
          <rdf:li xml:lang="x-default">American Society for Microbiology</rdf:li>
        </rdf:Bag>
      </dc:publisher>
      <dc:rightsHolder>
